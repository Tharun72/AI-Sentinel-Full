APP_NAME=AI Sentinel
APP_VERSION=1.0.0
HOST=127.0.0.1
PORT=8000
DATABASE_URL=postgresql+psycopg2://ai_sentinel:change_me@127.0.0.1:5432/ai_sentinel
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_CONNECT_TIMEOUT_SECONDS=10
OLLAMA_READ_TIMEOUT_SECONDS=20
AI_MAX_SOURCE_CONTEXT_CHARS=2000
AI_ENABLED=true
AI_MAX_FINDINGS=20
AI_ENRICHMENT_CONCURRENCY=2
AI_MAX_DURATION_SECONDS=120
GIT_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org
GIT_CLONE_TIMEOUT_SECONDS=120
SCAN_MAX_FILE_SIZE_BYTES=1000000
SCAN_MAX_FILES=10000
SCAN_MAX_REPOSITORY_SIZE_BYTES=500000000
SCAN_TOTAL_TIMEOUT_SECONDS=600
SCAN_PROGRESS_UPDATE_INTERVAL_SECONDS=0.5
STALE_SCAN_TIMEOUT_SECONDS=900
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=uploads
REPORT_DIR=reports
